# Copy to .env and fill in. Comments must go on their own line (Docker and kubectl
# do not strip inline comments from env files).

# Port the page listens on, and the public URL linked from GitLab issues.
PORT=8080
PUBLIC_URL=https://status.example.internal
CONFIG=config/services.json

# GitLab: project access token with scope "api" and role Reporter or higher.
# Without a token the page runs in dry-run (logs what it would do in GitLab).
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxx
# Project path (group/project) or numeric id.
GITLAB_PROJECT=devops/incidents

# Grafana: service account with role Viewer.
GRAFANA_URL=https://grafana.example.com
GRAFANA_TOKEN=glsa_xxxxxxxx

# Prometheus (or Mimir / Thanos / VictoriaMetrics), if queried directly.
PROMETHEUS_URL=http://prometheus:9090

# Shared secret for Grafana's webhook contact point (Authorization: Bearer …).
HOOK_TOKEN=change-me

# Time zone used for dates written into issues.
DISPLAY_TZ=Europe/Madrid
